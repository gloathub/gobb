{:schema 1
 :normalizations
 [{:id :working-directory
   :automatic true
   :description "Replace each isolated fixture directory with <WORKDIR>"}
  {:id :platform-separators
   :automatic true
   :description "Use forward slashes in captured paths on every platform"}
  {:id :timestamp
   :pattern "\\b\\d{13}\\b"
   :replacement "<TIMESTAMP>"
   :description "Replace explicitly declared millisecond timestamps"}
  {:id :process-id
   :pattern "pid=\\d+"
   :replacement "pid=<PID>"
   :description "Replace explicitly declared process identifiers"}
  {:id :port
   :pattern "port=\\d+"
   :replacement "port=<PORT>"
   :description "Replace explicitly declared ephemeral port numbers"}]

 :fixtures
 [{:id :cli/expression
   :area :cli
   :description "Evaluate an expression"
   :args ["-e" "(+ 20 22)"]}

  {:id :cli/arguments
   :area :cli
   :description "Bind expression command-line arguments"
   :args ["-e" "(prn *command-line-args*)" "alpha" "beta"]}

  {:id :cli/expression-file
   :area :execution-state
   :description "Bind BB's expression source marker"
   :args ["-e" "(prn *file*)"]}

  {:id :reader/collections
   :area :reader
   :description "Read and print nested collection literals"
   :args ["-e" "(prn {:vector [1 2 3] :list '(a b) :keyword :ok})"]}

  {:id :reader/bb-feature
   :area :reader
   :description "Select the :bb reader-conditional branch"
   :args ["-e" "#?(:bb :bb :default :other)"]}

  {:id :reader/gobb-feature
   :area :reader
   :description "Select Gobb's additional reader-conditional branch"
   :args ["-e" "#?(:gobb :gobb :default :other)"]
   :expect :difference
   :rationale "The :gobb feature is intentionally active only under Gobb"}

  {:id :reader/data-readers
   :area :reader
   :description "Load a tagged-literal reader from data_readers.clj"
   :args ["-cp" "{fixtures}/classpath"
          "-e"
          "(require 'gobb.fixture.readers) #fixture/tag {:answer 42}"]}

  {:id :printing/basic
   :area :printing
   :description "Preserve print and prn output"
   :args ["-e" "(do (print \"left:\") (prn {:right 42}))"]}

  {:id :namespace/switch
   :area :namespace
   :description "Create and switch the current namespace"
   :args ["-e" "(ns compat.alpha) (println (ns-name *ns*))"]}

  {:id :vars/dynamic
   :area :dynamic-vars
   :description "Bind dynamic command-line state"
   :args ["-e" "(binding [*print-length* 2] (prn [1 2 3 4]))"]}

  {:id :loading/script
   :area :script-loading
   :description "Load a script with arguments"
   :args ["{fixtures}/args.clj" "alpha" "beta"]}

  {:id :loading/script-state
   :area :execution-state
   :description "Bind absolute *file*, arguments, and working directory"
   :args ["{fixtures}/runtime-state.clj" "alpha" "beta"]}

  {:id :loading/require
   :area :script-loading
   :description "Require source from an explicit classpath"
   :args ["-cp" "{fixtures}/classpath"
          "-e"
          "(require '[gobb.fixture.math-ops :as math]) (math/answer 40)"]}

  {:id :loading/repeated-require
   :area :script-loading
   :description "Repeated require preserves the loaded namespace"
   :args ["-cp" "{fixtures}/classpath"
          "-e"
          "(require 'gobb.fixture.math-ops) (require 'gobb.fixture.math-ops) (gobb.fixture.math-ops/answer 40)"]}

  {:id :loading/resource
   :area :script-loading
   :description "Resolve and read a resource from the runtime classpath"
   :args ["-cp" "{fixtures}/classpath"
          "-e"
          "(require '[clojure.java.io :as io]) (slurp (io/resource \"fixture-resource.txt\"))"]}

  {:id :loading/preloads
   :area :script-loading
   :description "Evaluate BABASHKA_PRELOADS before the expression"
   :env {"BABASHKA_PRELOADS" "(def preload-value 42)"}
   :args ["-e" "preload-value"]}

  {:id :loading/init
   :area :script-loading
   :description "Evaluate --init before the expression"
   :args ["--init" "{fixtures}/init.clj"
          "-e"
          "(prn init-value)"]}

  {:id :invocation/main
   :area :invocation
   :description "Invoke a namespace -main with command-line arguments"
   :args ["-cp" "{fixtures}/classpath"
          "-m"
          "gobb.fixture.entry"
          "alpha"
          "beta"]}

  {:id :invocation/main-var
   :area :invocation
   :description "Invoke a qualified var through -m"
   :args ["-cp" "{fixtures}/classpath"
          "-m"
          "gobb.fixture.entry/alternate"
          "alpha"]}

  {:id :invocation/exec
   :area :invocation
   :description "Invoke a qualified var through -x with parsed options"
   :args ["-cp" "{fixtures}/classpath"
          "-x"
          "gobb.fixture.entry/exec"
          "--name"
          "Gobb"
          "--count"
          "2"
          "--enabled"]}

  {:id :runtime/working-directory
   :area :runtime
   :description "Normalize each isolated working directory"
   :args ["-e" "(println (System/getProperty \"user.dir\"))"]}

  {:id :runtime/environment
   :area :execution-state
   :description "Expose the inherited process environment"
   :env {"GOBB_COMPAT_ENV" "visible"}
   :args ["-e" "(prn (System/getenv \"GOBB_COMPAT_ENV\"))"]}

  {:id :runtime/timestamp
   :area :runtime
   :description "Normalize a declared millisecond timestamp"
   :normalizations [:timestamp]
   :args ["-e" "(println (System/currentTimeMillis))"]}

  {:id :errors/exception-data
   :area :errors
   :description "Preserve structured exception data"
   :args ["-e" "(prn (ex-data (ex-info \"boom\" {:kind :compat :code 42})))"]}

  {:id :io/stderr
   :area :errors
   :description "Bind *err* as the standard error writer"
   :args ["-e" "(binding [*out* *err*] (println \"compat warning\"))"]}

  {:id :io/stdin
   :area :execution-state
   :description "Bind *in* as the standard input reader"
   :stdin "compat input\n"
   :args ["-e" "(prn (slurp *in*))"]}

  {:id :exit/nonzero
   :area :exit
   :description "Preserve an explicit nonzero exit status"
   :args ["-e" "(System/exit 7)"]}

  {:id :filesystem/write
   :area :filesystem
   :description "Write a deterministic filesystem effect"
   :args ["-e" "(spit \"effect.txt\" \"42\")"]
   :expect :difference
   :rationale "Glojure's core spit host adapter is not linked into Gobb yet"}

  {:id :compiled/main
   :area :compiled-programs
   :kind :compiled
   :description "Compile and execute a namespace containing -main"
   :source "{fixtures}/gobb/build_smoke.clj"
   :bb-args ["-cp" "{fixtures}"
             "-e"
             "(require '[gobb.build-smoke :as smoke]) (smoke/-main)"]}

  {:id :compiled/host-state
   :area :compiled-programs
   :kind :compiled
   :description "Keep runtime and compiled namespace and binding state aligned"
   :source "{fixtures}/gobb/host_parity.clj"
   :env {"GOBB_PARITY_ENV" "visible"}
   :run-args ["alpha" "beta"]
   :bb-args ["-cp" "{fixtures}"
             "-m"
             "gobb.host-parity"
             "alpha"
             "beta"]}]}
