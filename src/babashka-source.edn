{:babashka
 {:tag "v1.12.218"
  :revision "0fb349c414e717800be775ba9cb77c95a9eb700d"
  :source-root "src"}

 ;; Every namespace discovered under Babashka's source root receives this
 ;; disposition unless it has an explicit entry below. This keeps the ledger
 ;; complete as upstream adds namespaces while requiring an intentional opt-in
 ;; before any new source enters a Gobb binary.
 :default
 {:disposition :deferred
  :reason "Requires compatibility work for SCI, JVM/Graal APIs, or dependencies"}

 :namespaces
 {babashka.impl.exceptions
  {:disposition :upstream
   :path "babashka/impl/exceptions.clj"
   :reason "Pure namespace with no SCI, JVM, or Graal dependency"}

  babashka.impl.clojure.main
  {:disposition :adapted
   :path "babashka/impl/clojure/main.clj"
   :target-namespace gobb.bb-repl
   :forms [with-bindings repl]
   :reason "BB's reusable REPL loop, projected without its JVM-only default reader"
   :adaptations
   ["Use a portable always-prompt default instead of LineNumberingPushbackReader"
    "Use generated symbols for the two JVM Object sentinels"
    "Omit the JVM-only *math-context* thread binding"
    "Use portable string and identity error handling instead of JVM Throwable accessors"
    "Name wrapped print errors :gobb/error instead of :sci/error"]}}}
