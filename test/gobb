#!/usr/bin/env bash

set -euo pipefail

: "${GOBB:?GOBB must name the Gobb executable}"
: "${BB:?BB must name the BB executable}"

fail() {
  echo "test/gobb: $*" >&2
  exit 1
}

check() {
  local description=$1 expected=$2
  shift 2
  local actual
  actual=$("$@")
  [[ $actual == "$expected" ]] ||
    fail "$description: expected '$expected', got '$actual'"
}

check "expression evaluation" "3" \
  "$GOBB" -e '(+ 1 2)'

check "expression source marker" '"NO_SOURCE_PATH"' \
  "$GOBB" -e '(prn *file*)'

check "initial execution namespace" "user" \
  "$GOBB" -e '(ns-name *ns*)'

check "BB reader feature" ":bb" \
  "$GOBB" -e '#?(:bb :bb :default :other)'

check "Gobb reader feature" ":gobb" \
  "$GOBB" -e '#?(:gobb :gobb :default :other)'

check "splicing reader feature" "[1 2]" \
  "$GOBB" -e '[#?@(:bb [1 2] :default [3])]'

check "Babashka version property" "1.12.218" \
  "$GOBB" -e '(println (System/getProperty "babashka.version"))'

check "initial Java classpath property" '""' \
  "$GOBB" -e '(prn (System/getProperty "java.class.path"))'

expected_version="gobb v$(< VERSION)"
check "version output" "$expected_version" \
  "$GOBB" --version

check "build help" \
  "Usage: gobb build INPUT -o OUTPUT [--platform OS/ARCH]" \
  "$GOBB" build --help

check "definitions persist between forms" "42" \
  "$GOBB" -e '(def x 41) (inc x)'

require_expression="(require '[gobb.fixture.math-ops :as math]) (math/answer 40)"
check "explicit classpath require" "42" \
  "$GOBB" --classpath test/fixtures/classpath -e "$require_expression"

check "short classpath option" "42" \
  "$GOBB" -cp test/fixtures/classpath -e "$require_expression"

check "data readers" '[:fixture/tag {:answer 42}]' \
  "$GOBB" -cp test/fixtures/classpath \
  -e "(require 'gobb.fixture.readers) #fixture/tag {:answer 42}"

check "repeated require" "42" \
  "$GOBB" -cp test/fixtures/classpath \
  -e "(require 'gobb.fixture.math-ops)
      (require 'gobb.fixture.math-ops)
      (gobb.fixture.math-ops/answer 40)"

check "classpath resource" '"resource-loaded\n"' \
  "$GOBB" -cp test/fixtures/classpath \
  -e "(require '[clojure.java.io :as io])
      (slurp (io/resource \"fixture-resource.txt\"))"

check "working directory require" "7" \
  bash -c \
  'cd test/fixtures/classpath && "$1" -e "(require '"'"'[gobb.fixture.math-ops :as math]) (math/answer 5)"' \
  _ "$GOBB"

check "classpath system property" '"test/fixtures/classpath"' \
  "$GOBB" -cp test/fixtures/classpath \
  -e '(System/getProperty "java.class.path")'

check "stdin evaluation" "5" \
  bash -c "printf '(+ 2 3)\\n' | \"\$1\"" _ "$GOBB"

check "file arguments" '("alpha" "beta")' \
  "$GOBB" test/fixtures/args.clj alpha beta

check "file source binding" "$(realpath test/fixtures/file-var.clj)" \
  "$GOBB" test/fixtures/file-var.clj

check "preloads" "42" \
  env BABASHKA_PRELOADS='(def preload-value 42)' \
  "$GOBB" -e preload-value

check "init file" \
  "{:loaded true, :file \"$(realpath test/fixtures/init.clj)\"}" \
  "$GOBB" --init test/fixtures/init.clj -e '(prn init-value)'

check "namespace main" \
  '{:mode :main, :args ("alpha" "beta"), :file "NO_SOURCE_PATH"}' \
  "$GOBB" -cp test/fixtures/classpath \
  -m gobb.fixture.entry alpha beta

check "qualified main var" \
  '{:mode :alternate, :args ("alpha"), :file "NO_SOURCE_PATH"}' \
  "$GOBB" -cp test/fixtures/classpath \
  -m gobb.fixture.entry/alternate alpha

check "exec function" \
  '{:mode :exec, :options {:name "Gobb", :count 2, :enabled true}, :file "NO_SOURCE_PATH"}' \
  "$GOBB" -cp test/fixtures/classpath \
  -x gobb.fixture.entry/exec --name Gobb --count 2 --enabled

check "shutdown hook" $'body\nshutdown' \
  "$GOBB" -e \
  '(gobb.host/register-shutdown-hook! #(println "shutdown"))
   (println "body")'

check "default data reader" ":default-read" \
  env BABASHKA_PRELOADS='
    (alter-var-root
      (var *default-data-reader-fn*)
      (constantly (fn [_ _] :default-read)))' \
  "$GOBB" -e '#unknown/tag 42'

stderr_file=$(mktemp)
trap 'rm -f "$stderr_file"' EXIT
stdout=$(
  "$GOBB" -e \
    '(binding [*out* *err*] (println "compat warning"))' \
    2>"$stderr_file"
)
[[ -z $stdout && $(<"$stderr_file") == "compat warning" ]] ||
  fail "*err* is not bound to standard error"

expected_file_properties="1.12.218
$(realpath test/fixtures/system-properties.clj)"
check "file system properties" "$expected_file_properties" \
  "$GOBB" test/fixtures/system-properties.clj

gobb_output=$("$GOBB" -e '(str "go" "bb")')
bb_output=$("$BB" -e '(str "go" "bb")')
[[ $gobb_output == "$bb_output" ]] ||
  fail "BB comparison: Gobb '$gobb_output', BB '$bb_output'"

gobb_require_output=$(
  "$GOBB" --classpath test/fixtures/classpath -e "$require_expression"
)
bb_require_output=$(
  "$BB" --classpath test/fixtures/classpath -e "$require_expression"
)
[[ $gobb_require_output == "$bb_require_output" ]] ||
  fail "BB require comparison: Gobb '$gobb_require_output', BB '$bb_require_output'"

if "$GOBB" -e >/dev/null 2>&1; then
  fail "missing -e expression succeeded"
fi

if "$GOBB" --classpath >/dev/null 2>&1; then
  fail "missing --classpath path succeeded"
fi

if "$GOBB" build test/fixtures/gobb/build_smoke.clj >/dev/null 2>&1; then
  fail "gobb build without -o succeeded"
fi

if "$GOBB" --not-an-option >/dev/null 2>&1; then
  fail "unknown option succeeded"
fi

repl_output=$("$GOBB" </dev/null)
expected_repl_banner="Gobb v$(< VERSION)
Babashka v1.12.218
Type :repl/help for help
user=> "
[[ $repl_output == "$expected_repl_banner" ]] ||
  fail "REPL banner: expected '$expected_repl_banner', got '$repl_output'"

repl_session=$(
  printf '%s\n' \
    '(+ 1 2)' \
    '(def x' \
    '  7)' \
    '(prn *file*)' \
    '(throw (ex-info "repl boom" {}))' \
    '(* x 6)' \
    '*1' \
    ':repl/exit' |
    "$GOBB" --repl
)

[[ $repl_session == *"user=> 3"* ]] ||
  fail "REPL did not evaluate an expression"
[[ $repl_session == *"#'user/x"* ]] ||
  fail "REPL did not preserve a multiline definition"
[[ $repl_session == *'"<repl>"'* ]] ||
  fail "REPL did not bind *file*"
[[ $repl_session == *"Error: repl boom"* ]] ||
  fail "REPL did not render the underlying exception"
[[ $repl_session == *"user=> 42"* ]] ||
  fail "REPL did not use the preserved definition"
[[ $(grep -o 'user=> 42' <<< "$repl_session" | wc -l) -eq 2 ]] ||
  fail "REPL did not preserve *1"

set +e
reader_error=$("$GOBB" -e '(' 2>&1)
reader_status=$?
runtime_error=$("$GOBB" -e '(throw (ex-info "boom" {}))' 2>&1)
runtime_status=$?
file_error=$("$GOBB" test/fixtures/error.clj 2>&1)
file_error_status=$?
set -e

[[ $reader_status -ne 0 && $reader_error ]] ||
  fail "invalid syntax did not produce a useful failure"

[[ $runtime_status -ne 0 && $runtime_error == *boom* ]] ||
  fail "runtime exception did not produce a useful failure"
[[ $runtime_error != *"goroutine "* && $runtime_error != panic:* ]] ||
  fail "runtime exception leaked a Go panic stack"
[[ $file_error_status -ne 0 &&
   $file_error == *"$(realpath test/fixtures/error.clj)"* &&
   $file_error == *"file boom"* ]] ||
  fail "file exception did not include its source path"

if rg -n '\bsci(\.|/|\b)' src/gobb >/dev/null; then
  fail "Gobb-owned runtime source depends on SCI"
fi

if command -v timeout >/dev/null 2>&1; then
  set +e
  timeout --preserve-status -s INT 0.2 \
    "$GOBB" -e '(Thread/sleep 5000)' >/dev/null 2>&1
  interrupt_status=$?
  set -e
  [[ $interrupt_status -eq 130 ]] ||
    fail "SIGINT did not terminate Gobb with status 130"
fi

echo "All Gobb tests passed"
