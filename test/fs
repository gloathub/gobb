#!/usr/bin/env bash

set -euo pipefail

: "${GOBB:?GOBB must name the Gobb executable}"
: "${BB:?BB must name the Babashka executable}"

root=$(cd "$(dirname "$0")/.." && pwd)
fixture=$root/test/fixtures/fs/core.clj
archive_fixture=$root/test/fixtures/fs/archive.clj
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

mkdir "$tmp/bb" "$tmp/gobb"

"$BB" "$fixture" "$tmp/bb" >"$tmp/bb.edn"
"$GOBB" "$fixture" "$tmp/gobb" >"$tmp/gobb.edn"

if ! diff -u "$tmp/bb.edn" "$tmp/gobb.edn"; then
  echo "test/fs: Gobb babashka.fs behavior differs from BB" >&2
  exit 1
fi

(
  cd "$tmp/bb"
  "$BB" "$archive_fixture"
) >"$tmp/bb-archive.edn"
(
  cd "$tmp/gobb"
  "$GOBB" "$archive_fixture"
) >"$tmp/gobb-archive.edn"

if ! diff -u "$tmp/bb-archive.edn" "$tmp/gobb-archive.edn"; then
  echo "test/fs: Gobb archive behavior differs from BB" >&2
  exit 1
fi

echo "Core babashka.fs compatibility tests passed"
