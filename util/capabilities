#!/usr/bin/env bb

(require '[babashka.fs :as fs]
         '[clojure.edn :as edn]
         '[clojure.pprint :as pprint]
         '[clojure.string :as str])

(def allowed-statuses #{:available :limited :unavailable})
(def required-targets #{:native :wasi :browser})

(defn fail! [message]
  (binding [*out* *err*]
    (println (str "capabilities: " message)))
  (System/exit 1))

(defn validate! [spec]
  (when-not (= 1 (:schema spec))
    (fail! "unsupported schema"))
  (let [targets (map :id (:targets spec))
        capabilities (map :id (:capabilities spec))]
    (when-not (= required-targets (set targets))
      (fail! (str "targets must be " (pr-str required-targets))))
    (when-not (= (count targets) (count (set targets)))
      (fail! "duplicate target ids"))
    (when-not (= (count capabilities) (count (set capabilities)))
      (fail! "duplicate capability ids")))
  (doseq [{:keys [id operations targets]} (:capabilities spec)]
    (when-not (and (keyword? id) (seq operations))
      (fail! (str "invalid capability " (pr-str id))))
    (when-not (= required-targets (set (keys targets)))
      (fail! (str id " does not classify every target")))
    (doseq [[target {:keys [status rationale]}] targets]
      (when-not (allowed-statuses status)
        (fail! (str id "/" target " has invalid status " status)))
      (when (and (not= :available status) (str/blank? rationale))
        (fail! (str id "/" target " requires a rationale")))))
  spec)

(defn runtime-source [spec]
  (let [matrix (into (sorted-map)
                     (map (juxt :id identity))
                     (:capabilities spec))]
    (str
     ";; Generated by make capabilities. Do not edit.\n"
     "(ns gobb.capability-matrix)\n\n"
     "(def statuses " (pr-str (set (keys (:statuses spec)))) ")\n\n"
     "(def targets " (pr-str required-targets) ")\n\n"
     "(def matrix\n"
     (with-out-str (pprint/pprint matrix))
     ")\n")))

(defn status-cell [{:keys [status rationale]}]
  (str "**" (name status) "**"
       (when rationale (str "<br><small>" rationale "</small>"))))

(defn report [spec]
  (str
   "<!-- Generated by make capabilities. Do not edit. -->\n\n"
   "# Platform capabilities\n\n"
   "Gobb uses one explicit host-capability contract for interpreted and "
   "compiled programs. The same contract is executed under native Go, WASI, "
   "and browser Wasm during `make capability-test`.\n\n"
   "A **limited** capability exists but remains constrained by its host or "
   "sandbox. An **unavailable** operation throws structured exception data "
   "instead of leaking a Go or platform-specific failure.\n\n"
   "| Capability | Native | WASI | Browser Wasm |\n"
   "| --- | --- | --- | --- |\n"
   (str/join
    "\n"
    (for [{:keys [label targets]} (:capabilities spec)]
      (str "| " label
           " | " (status-cell (:native targets))
           " | " (status-cell (:wasi targets))
           " | " (status-cell (:browser targets))
           " |")))
   "\n\n"
   "## Structured failures\n\n"
   "Unavailable operations throw `ExceptionInfo` with stable data:\n\n"
   "```clojure\n"
   "{:type :gobb/unsupported-capability\n"
   " :capability :process\n"
   " :target :browser\n"
   " :platform \"js/wasm\"\n"
   " :operation :spawn\n"
   " :status :unavailable}\n"
   "```\n\n"
   "The target is derived from Go's compile-time `GOOS` and `GOARCH`; callers "
   "do not configure it at runtime.\n\n"
   "## Host adapters\n\n"
   "`gobb.capabilities` owns the low-level boundaries used by future BB "
   "library ports: environment lookup, clocks, secure randomness, filesystem "
   "I/O, working-directory access, and subprocess execution. Higher-level "
   "ports such as `babashka.fs` and `babashka.process` build on these adapters "
   "in later milestones.\n\n"
   "Regenerate the runtime contract and this page with:\n\n"
   "```sh\nmake capabilities\n```\n"))

(defn write-if-changed! [path content]
  (when-not (and (fs/exists? path)
                 (= content (slurp path)))
    (spit path content)))

(let [[spec-path source-path report-path] *command-line-args*]
  (when-not (every? some? [spec-path source-path report-path])
    (fail! "usage: util/capabilities SPEC SOURCE REPORT"))
  (let [spec (validate! (edn/read-string (slurp spec-path)))]
    (fs/create-dirs (fs/parent source-path))
    (fs/create-dirs (fs/parent report-path))
    (write-if-changed! source-path (runtime-source spec))
    (write-if-changed! report-path (report spec))
    (println
     (format "Generated %d capabilities for %d targets"
             (count (:capabilities spec))
             (count (:targets spec))))))
