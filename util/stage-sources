#!/usr/bin/env bb

(require '[babashka.fs :as fs]
         '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.walk :as walk]
         '[clojure.string :as str])

(defn die [& messages]
  (binding [*out* *err*]
    (doseq [message messages]
      (println (str "stage-sources: " message))))
  (System/exit 1))

(defn namespace-in [file]
  (with-open [reader (java.io.PushbackReader.
                      (io/reader (str file)))]
    (loop []
      (let [form (read {:eof ::eof
                        :read-cond :allow
                        :features #{:clj}}
                       reader)]
        (cond
          (= ::eof form) nil
          (and (seq? form) (= 'ns (first form))) (second form)
          :else (recur))))))

(defn flat-name [namespace]
  (str (str/replace (str namespace) #"[.-]" "_") ".clj"))

(defn discover-upstream [source-root]
  (reduce
   (fn [namespaces file]
     (let [namespace (namespace-in file)]
       (when-not namespace
         (die "cannot find namespace in " file))
       (when-let [previous (get-in namespaces [namespace :path])]
         (die "duplicate upstream namespace " namespace
              "  first: " previous
              "  again: " file))
       (assoc namespaces namespace
              {:path (str (fs/relativize source-root file))})))
   (sorted-map)
   (sort (fs/glob source-root "**/*.clj"))))

(defn stage-file! [providers stage-dir entry-namespace namespace source]
  (when-let [previous (get @providers namespace)]
    (die "duplicate namespace " namespace
         "  first: " previous
         "  again: " source))
  (swap! providers assoc namespace (str source))
  (let [target (fs/path stage-dir
                        (if (= namespace entry-namespace)
                          "main.clj"
                          (flat-name namespace)))]
    (fs/copy source target {:replace-existing true})))

(defn read-forms [source]
  (with-open [reader (java.io.PushbackReader.
                      (io/reader (str source)))]
    (loop [forms []]
      (let [form (read {:eof ::eof
                        :read-cond :allow
                        :features #{:clj}}
                       reader)]
        (if (= ::eof form)
          forms
          (recur (conj forms form)))))))

(defn source-files [source-root]
  (if (fs/regular-file? source-root)
    [source-root]
    (sort
     (concat
      (fs/glob source-root "**/*.clj")
      (fs/glob source-root "**/*.cljc")))))

(defn adapt-external-form [form]
  (walk/postwalk
   (fn [node]
     (cond
       (and (seq? node)
            (= 'defn (first node))
            (= 'zipper (second node))
            (contains? (meta (last node)) :zip/branch?))
       (concat
        (butlast node)
        '((with-meta
            [root nil]
            {:zip/branch? branch?
             :zip/children children
             :zip/make-node make-node})))

       (= node 'java.io.PushbackReader.)
       'clojure.lang.LineNumberingPushbackReader.

       (= node 'babashka.cli.internal)
       'babashka.cli-internal

       (and (seq? node)
            (= 'defn- (first node))
            (= 'parse-number (second node)))
       '(defn- parse-number [value]
          (let [parsed (edn/read-string value)]
            (if (number? parsed)
              parsed
              (throw-unexpected value))))

       (and (seq? node)
            (= 'reduce (first node))
            (<= 3 (count node)))
       (concat (butlast node)
               [(list 'vec (last node))])

       (and (seq? node)
            (= 'into (first node))
            (<= 3 (count node)))
       (concat (butlast node)
               [(list 'or (last node) [])])

       :else node))
   form))

(defn external-namespace [namespace]
  (case namespace
    babashka.cli.internal 'babashka.cli-internal
    namespace))

(defn write-build-sources! [providers stage-dir]
  (when (contains? @providers 'gobb.cli)
    (let [namespace 'gobb.build-sources
          target (fs/path stage-dir "gobb_build_sources.clj")
          files (->> (fs/glob stage-dir "*.clj")
                     (remove #(contains? #{"main.clj"
                                           "gobb_build_sources.clj"}
                                         (str (fs/file-name %))))
                     vec)
          namespaces (set (map namespace-in files))
          sources
          (->> files
               (map (fn [source]
                      (let [source-namespace (namespace-in source)
                            requires (->> (read-forms source)
                                          (mapcat #(tree-seq coll? seq %))
                                          (filter symbol?)
                                          (filter namespaces)
                                          (remove #{source-namespace})
                                          set)]
                        [source-namespace
                         {:path (str (-> source-namespace
                                         str
                                         (str/replace "." "/")
                                         (str/replace "-" "_"))
                                     ".clj")
                          :stage-path (flat-name source-namespace)
                          :requires requires
                          :source (slurp (str source))}])))
               (into (sorted-map)))]
      (when-let [previous (get @providers namespace)]
        (die "duplicate namespace " namespace
             "  first: " previous
             "  again: generated build source bundle"))
      (swap! providers assoc namespace "generated build source bundle")
      (spit (str target)
            (str ";; Generated by util/stage-sources.\n"
                 ";; Carries Gobb's selected runtime source into gobb build.\n"
                 "(ns gobb.build-sources)\n\n"
                 "(def sources '" (pr-str sources) ")\n")))))

(defn stage-external! [providers stage-dir entry-namespace source-root]
  (when-not (or (fs/directory? source-root)
                (fs/regular-file? source-root))
    (die "external source root not found: " source-root))
  (reduce
   (fn [count source]
     (let [source-namespace (namespace-in source)
           namespace (external-namespace source-namespace)]
       (when-not source-namespace
         (die "cannot find namespace in " source))
       (when-let [previous (get @providers namespace)]
         (die "duplicate namespace " namespace
              "  first: " previous
              "  again: " source))
       (swap! providers assoc namespace (str source))
       (let [target (fs/path stage-dir
                             (if (= namespace entry-namespace)
                               "main.clj"
                               (flat-name namespace)))]
         (spit
          (str target)
          (str ";; Generated from pinned external Clojure source.\n"
               ";; Original source: " source "\n\n"
               (str/join "\n\n"
                         (map (comp pr-str adapt-external-form)
                              (read-forms source)))
               "\n")))
       (inc count)))
   0
   (source-files source-root)))

(defn definition-name [form]
  (when (and (seq? form)
             (contains? '#{def defn defmacro} (first form)))
    (second form)))

(defn adapt-repl-form [form]
  (walk/postwalk
   (fn [node]
     (cond
       (= node '(instance? LineNumberingPushbackReader *in*)) true
       (= node '(Object.)) '(gensym)
       (= node :sci/error) :gobb/error
       (and (seq? node) (= 'ex-cause (first node))) (second node)
       (and (seq? node) (= 'ex-message (first node)))
       (list 'str (second node))
       (= node
          '(clojure.core/list
            (quote clojure.core/*math-context*)))
       '(clojure.core/list)
       (and (vector? node)
            (some #{'clojure.core/*math-context*} node))
       (vec (mapcat identity
                    (remove (fn [[var _]]
                              (= var 'clojure.core/*math-context*))
                            (partition 2 node))))
       :else node))
   form))

(defn stage-adapted! [providers stage-dir entry-namespace namespace
                      source {:keys [target-namespace forms]}]
  (let [by-name (into {} (keep (fn [form]
                                 (when-let [name (definition-name form)]
                                   [name form])))
                      (read-forms source))
        missing (remove #(contains? by-name %) forms)
        target (fs/path stage-dir
                        (if (= target-namespace entry-namespace)
                          "main.clj"
                          (flat-name target-namespace)))]
    (when (seq missing)
      (die "adapted source definitions missing from " source ": "
           (str/join ", " missing)))
    (when-let [previous (get @providers target-namespace)]
      (die "duplicate namespace " target-namespace
           "  first: " previous
           "  again: " source))
    (swap! providers assoc target-namespace
           (str source " (adapted from " namespace ")"))
    (spit (str target)
          (str ";; Copyright (c) Rich Hickey. All rights reserved.\n"
               ";; Distributed under the Eclipse Public License 1.0.\n"
               ";; Generated from pinned Babashka source by util/stage-sources.\n"
               ";; See src/babashka-source.edn for the exact adaptation.\n"
               "(ns " target-namespace
               " (:refer-clojure :exclude [with-bindings]))\n\n"
               (str/join "\n\n"
                         (map (comp pr-str adapt-repl-form by-name) forms))
               "\n"))))

(let [[manifest-file babashka-dir gobb-src-dir stage-dir version-file
       entry-namespace-arg & extra-arguments]
      *command-line-args*]
  (when (some nil? [manifest-file babashka-dir gobb-src-dir
                    stage-dir version-file])
    (die (str "usage: stage-sources MANIFEST BABASHKA-DIR GOBB-SRC-DIR "
              "STAGE-DIR VERSION-FILE [ENTRY-NAMESPACE [EXTERNAL-ROOT...]]")))
  (let [namespace-prefix "--gobb-namespaces="
        namespace-option
        (some #(when (str/starts-with? % namespace-prefix) %)
              extra-arguments)
        external-roots
        (remove #(str/starts-with? % namespace-prefix)
                extra-arguments)
        selected-gobb-namespaces
        (when namespace-option
          (->> (str/split
                (subs namespace-option (count namespace-prefix))
                #",")
               (remove str/blank?)
               (map symbol)
               set))
        manifest (edn/read-string (slurp manifest-file))
        entry-namespace (symbol (or entry-namespace-arg "gobb.cli"))
        source-root (fs/path babashka-dir
                             (get-in manifest [:babashka :source-root]))
        discovered (discover-upstream source-root)
        overrides (:namespaces manifest)
        unknown (remove #(contains? discovered %) (keys overrides))
        ledger (into (sorted-map)
                     (map (fn [[namespace data]]
                            [namespace
                             (merge (:default manifest)
                                    data
                                    (get overrides namespace))]))
                     discovered)
        selected (filter (fn [[_ data]]
                           (= :upstream (:disposition data)))
                         ledger)
        adapted (filter (fn [[_ data]]
                          (= :adapted (:disposition data)))
                        ledger)
        gobb-files
        (->> (fs/glob gobb-src-dir "**/*.clj")
             (filter
              (fn [source]
                (or (nil? selected-gobb-namespaces)
                    (contains? selected-gobb-namespaces
                               (namespace-in source)))))
             sort)
        providers (atom {})
        external-count (atom 0)]
    (when-not (fs/directory? source-root)
      (die "Babashka source root not found: " source-root))
    (when (seq unknown)
      (die "manifest contains unknown namespaces: "
           (str/join ", " unknown)))
    (fs/delete-tree stage-dir)
    (fs/create-dirs stage-dir)
    (doseq [[namespace {:keys [path]}] selected]
      (let [source (fs/path source-root path)]
        (when-not (fs/regular-file? source)
          (die "selected upstream source not found: " source))
        (when-not (= namespace (namespace-in source))
          (die "namespace mismatch for " source))
        (stage-file! providers stage-dir entry-namespace namespace source)))
    (doseq [[namespace data] adapted]
      (let [source (fs/path source-root (:path data))]
        (when-not (fs/regular-file? source)
          (die "adapted upstream source not found: " source))
        (when-not (= namespace (namespace-in source))
          (die "namespace mismatch for " source))
        (stage-adapted! providers stage-dir entry-namespace namespace
                        source data)))
    (doseq [source gobb-files]
      (let [namespace (namespace-in source)]
        (when-not namespace
          (die "cannot find namespace in " source))
        (stage-file! providers stage-dir entry-namespace namespace source)))
    (doseq [external-root external-roots]
      (swap! external-count +
             (stage-external! providers stage-dir entry-namespace
                              (fs/path external-root))))
    (let [version (str/trim (slurp version-file))
          babashka-version (str/replace
                            (get-in manifest [:babashka :tag])
                            #"^v" "")
          namespace 'gobb.version
          target (fs/path stage-dir "gobb_version.clj")]
      (when (str/blank? version)
        (die "VERSION file is empty"))
      (when-let [previous (get @providers namespace)]
        (die "duplicate namespace " namespace
             "  first: " previous
             "  again: " version-file))
      (swap! providers assoc namespace (str version-file))
      (spit (str target)
            (str "(ns gobb.version)\n\n"
                 "(def version " (pr-str version) ")\n"
                 "(def babashka-version "
                 (pr-str babashka-version) ")\n")))
    (write-build-sources! providers stage-dir)
    (spit (str (fs/path stage-dir "ledger.edn"))
          (with-out-str
            (prn {:babashka (:babashka manifest)
                  :counts (frequencies (map (comp :disposition val) ledger))
                  :namespaces ledger})))
    (println "Staged" (count @providers) "namespaces;"
             (+ (count selected) (count adapted)) "from Babashka and"
             (count gobb-files) "from Gobb and"
             @external-count "from pinned external sources")))
