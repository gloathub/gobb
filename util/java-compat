#!/usr/bin/env bb

(require '[babashka.fs :as fs]
         '[clojure.edn :as edn]
         '[clojure.pprint :as pprint]
         '[clojure.string :as str])

(defn fail! [message]
  (binding [*out* *err*]
    (println (str "java-compat: " message)))
  (System/exit 1))

(defn read-edn [path]
  (edn/read-string (slurp path)))

(defn source-files [root]
  (->> ["src" "test" "examples"]
       (map #(fs/path root %))
       (filter fs/exists?)
       (map #(java.io.File. (str %)))
       (mapcat file-seq)
       (filter #(.isFile %))
       (filter #(re-find #"\.(clj|cljc|bb|edn)$" (str %)))
       sort))

(defn demand-pattern [class-name]
  (let [short-name (last (str/split class-name #"\."))
        escaped-full (java.util.regex.Pattern/quote class-name)
        escaped-short (java.util.regex.Pattern/quote short-name)]
    (re-pattern
     (str "(?:" escaped-full
          "|" escaped-short "(?:/|\\.|\\b))"))))

(defn demand [texts class-name]
  (let [pattern (demand-pattern class-name)
        matches
        (for [[path text] texts
              :let [count (count (re-seq pattern text))]
              :when (pos? count)]
          {:path path :count count})]
    {:count (reduce + 0 (map :count matches))
     :files (count matches)
     :evidence (->> matches
                    (sort-by (juxt (comp - :count) :path))
                    (take 5)
                    vec)}))

(defn limitation? [spec class-name]
  (some #(re-find (re-pattern %) class-name)
        (:limitation-patterns spec)))

(defn owner [spec class-name]
  (if (limitation? spec class-name)
    :explicit-limitation
    (or
     (some (fn [{:keys [pattern owner]}]
             (when (re-find (re-pattern pattern) class-name)
               owner))
           (:owner-routes spec))
     :glojure)))

(defn state [spec class-name]
  (cond
    (contains? (:supported spec) class-name) :supported
    (contains? (:staged spec) class-name) :partial
    (contains? (:partial spec) class-name) :partial
    (limitation? spec class-name) :intentional-difference
    :else :planned))

(defn wave [spec class-name]
  (if (some #(str/starts-with? class-name %)
            (:core-wave-prefixes spec))
    :core
    :later))

(defn rank-key [item]
  [(- (get-in item [:demand :count]))
   (- (get-in item [:demand :files]))
   (:name item)])

(defn status-counts [items key]
  (into (sorted-map)
        (frequencies (map key items))))

(defn validate! [spec classes items]
  (when-not (= 1 (:schema spec))
    (fail! "unsupported schema"))
  (when-not (= 583 (count classes))
    (fail! (str "expected 583 exposed classes, got " (count classes))))
  (when-not (= (count classes) (count items))
    (fail! "class ledger is incomplete"))
  (doseq [item items]
    (when-not (contains? (:owners spec) (:owner item))
      (fail! (str "missing owner for " (:name item))))
    (when-not (:state item)
      (fail! (str "missing disposition for " (:name item))))))

(defn ledger-text [ledger]
  (with-out-str
    (println ";; Generated by make java-compat. Do not edit.")
    (pprint/pprint ledger)))

(defn evidence-text [item]
  (if-let [evidence (seq (get-in item [:demand :evidence]))]
    (str/join "<br>"
              (map #(str "`" (:path %) "` (" (:count %) ")")
                   evidence))
    "Exposed by BB; no direct pinned-source reference"))

(defn report [ledger]
  (let [items (:classes ledger)
        top (take 50 items)
        core (filter #(= :core (:wave %)) items)]
    (str
     "# Java compatibility\n\n"
     "<!-- Generated by make java-compat. Do not edit. -->\n\n"
     "Gobb inventories every Java class exposed by Babashka **"
     (get-in ledger [:babashka :version])
     "**. Demand is measured from references in the pinned BB source, tests, "
     "and examples. A class name in this report is not a claim that a JVM "
     "exists: supported classes are portable Glojure, gojava, or Go-host "
     "adapters.\n\n"
     "## Disposition\n\n"
     "| State | Classes |\n| --- | ---: |\n"
     (apply str
            (for [[state count] (get-in ledger [:summary :states])]
              (str "| " (name state) " | " count " |\n")))
     "\n## Implementation ownership\n\n"
     "| Owner | Classes | Responsibility |\n| --- | ---: | --- |\n"
     (apply str
            (for [[owner count] (get-in ledger [:summary :owners])]
              (str "| `" (name owner) "` | " count " | "
                   (get-in ledger [:owners owner]) " |\n")))
     "\n## Core wave\n\n"
     "The first wave covers `java.lang`, `java.io`, and `java.nio.file`. "
     "Supported entries below have constructor, method, field, or instance "
     "evidence in `test/java-compat` and the compiled target probe.\n\n"
     "| Class | Owner | State | Demand |\n| --- | --- | --- | ---: |\n"
     (apply str
            (for [item (sort-by :name core)]
              (str "| `" (:name item) "` | `" (name (:owner item))
                   "` | **" (name (:state item)) "** | "
                   (get-in item [:demand :count]) " |\n")))
     "\n## Highest-demand classes\n\n"
     "| Rank | Class | Owner | State | References | Evidence |\n"
     "| ---: | --- | --- | --- | ---: | --- |\n"
     (apply str
            (map-indexed
             (fn [index item]
               (str "| " (inc index) " | `" (:name item) "` | `"
                    (name (:owner item)) "` | " (name (:state item))
                    " | " (get-in item [:demand :count])
                    " | " (evidence-text item) " |\n"))
             top))
     "\nThe complete 583-class ledger is tracked in "
     "[`compat/java-classes.edn`](https://github.com/clojurestar/gobb/blob/main/compat/java-classes.edn).\n\n"
     "Regenerate it with:\n\n```sh\nmake java-compat\n```\n")))

(let [[spec-path inventory-path source ledger-path report-path]
      *command-line-args*]
  (when-not (every? some?
                    [spec-path inventory-path source ledger-path report-path])
    (fail!
     "usage: util/java-compat SPEC INVENTORY BABASHKA-SOURCE LEDGER REPORT"))
  (let [spec (read-edn spec-path)
        inventory (read-edn inventory-path)
        classes (->> (:items inventory)
                     (filter #(= :java-class (:category %)))
                     (map :name)
                     distinct
                     sort
                     vec)
        texts (into {}
                    (for [path (source-files source)]
                      [(str (fs/relativize source path))
                       (slurp path)]))
        unranked
        (mapv
         (fn [class-name]
           {:name class-name
            :owner (owner spec class-name)
            :state (state spec class-name)
            :wave (wave spec class-name)
            :demand (demand texts class-name)
            :evidence
            (cond
              (contains? (:supported spec) class-name)
              [{:kind :test
                :path "test/java-compat"
                :description "Covered by focused and compiled cross-target probes"}]

              (contains? (:staged spec) class-name)
              [{:kind :implementation
                :path "/home/ingy/src/glojure/pkg/javacompat"
                :description "Bridge implemented; cross-target validation pending"}]

              (limitation? spec class-name)
              [{:kind :architecture
                :description "JVM-specific class has no portable Gobb equivalent"}]

              :else
              [{:kind :inventory
                :description "Assigned implementation owner; behavior not yet implemented"}])})
         classes)
        items (->> unranked (sort-by rank-key) vec)
        _ (validate! spec classes items)
        ledger
        {:schema 1
         :babashka (:babashka inventory)
         :owners (:owners spec)
         :summary {:total (count items)
                   :states (status-counts items :state)
                   :owners (status-counts items :owner)
                   :waves (status-counts items :wave)}
         :classes items}]
    (fs/create-dirs (fs/parent ledger-path))
    (fs/create-dirs (fs/parent report-path))
    (spit ledger-path (ledger-text ledger))
    (spit report-path (report ledger))
    (println
     (format "Ranked and assigned all %d BB-exposed Java classes"
             (count items)))))
