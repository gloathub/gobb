#!/usr/bin/env bb

(require '[babashka.fs :as fs]
         '[babashka.process :as process]
         '[clojure.edn :as edn]
         '[clojure.pprint :as pprint]
         '[clojure.string :as str]
         '[clojure.walk :as walk])

(defn fail! [message]
  (binding [*out* *err*] (println (str "upstream-tests: " message)))
  (System/exit 2))

(defn read-edn [path]
  (edn/read-string (slurp (str path))))

(defn write-edn! [path value]
  (fs/create-dirs (fs/parent path))
  (spit (str path)
        (binding [*print-namespace-maps* false]
          (with-out-str (pprint/pprint value)))))

(defn fail-command! [description {:keys [exit out err]}]
  (fail! (str description " failed with exit " exit
              (when-not (str/blank? err) (str "\n" err))
              (when-not (str/blank? out) (str "\n" out)))))

(defn run-command [command options]
  (let [result @(process/process command
                                 (merge {:out :string
                                         :err :string
                                         :continue true}
                                        options))]
    {:exit (:exit result)
     :out (:out result)
     :err (:err result)}))

(defn concise-error [{:keys [exit out err]}]
  (let [lines (->> (str/split-lines (str err "\n" out))
                   (map str/trim)
                   (remove str/blank?)
                   (remove #(or (= "GLJ Stack:" %)
                                (str/starts-with? % "Usage: "))))
        diagnostic (or (some #(when (re-find
                                     #"(failed to load|unable to|unsupported|cannot compile|String index|requires|bad binding|EvalASTMaybeHostForm)"
                                     %)
                                %)
                             lines)
                       (last lines))
        diagnostic (some-> diagnostic
                           (str/replace
                            #"^\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2} " "")
                           (str/replace #"^.*error evaluating [^:]+:\s*" "")
                           (str/replace #"0x[0-9a-fA-F]+" "<ADDR>"))]
    (str "exit " exit (when diagnostic (str ": " diagnostic)))))

(defn normalize [text replacements]
  (reduce (fn [value [from to]]
            (str/replace value (str from) to))
          (-> text
              (str/replace "\\" "/")
              (str/replace #"\r\n" "\n"))
          replacements))

(defn lib-summary [text]
  (some (fn [line]
          (try
            (let [value (edn/read-string line)]
              (when (and (map? value)
                         (every? #(contains? value %)
                                 [:test :pass :fail :error]))
                value))
            (catch Exception _ nil)))
        (reverse (str/split-lines text))))

(def extra-lib-test-namespaces
  '[babashka.process-test babashka.process-exec-test])

(defn lib-test-corpus [root]
  (let [manifest (read-edn
                  (fs/path root "test-resources" "lib_tests"
                           "bb-tested-libs.edn"))
        namespace-libraries
        (into {}
              (for [[library details] manifest
                    namespace (:test-namespaces details)]
                [(str namespace) library]))
        namespaces (->> (concat (mapcat :test-namespaces (vals manifest))
                                extra-lib-test-namespaces)
                        distinct
                        (sort-by str)
                        (mapv str))]
    {:libraries (count manifest)
     :namespaces namespaces
     :namespace-libraries namespace-libraries}))

(defn spec-test-require? [value]
  (and (vector? value)
       (= 'clojure.spec.test.alpha (first value))))

(defn adapt-lib-runner-form [form]
  (cond
    (and (seq? form) (= 'ns (first form)))
    (map (fn [clause]
           (if (and (seq? clause) (= :require (first clause)))
             (remove spec-test-require? clause)
             clause))
         form)

    (and (seq? form)
         (= 'def (first form))
         (= 'orig-spec-checking-fn (second form)))
    '(def orig-spec-checking-fn nil)

    :else
    (walk/postwalk
     (fn [value]
       (cond
         (and (seq? value)
              (= 'alter-var-root (first value))
              (= '(var st/spec-checking-fn) (second value)))
         nil

         (and (map? value) (vector? (:keys value)))
         (update value :keys
                 #(mapv (fn [binding]
                          (if (keyword? binding)
                            (symbol (name binding))
                            binding))
                        %))

         :else value))
     form)))

(defn prepare-lib-runner! [runner log-dir]
  (let [output (fs/path log-dir "run_all_libtests.clj")
        forms (with-open [reader (java.io.PushbackReader.
                                  (clojure.java.io/reader (str runner)))]
                (loop [values []]
                  (let [value (read {:eof ::eof} reader)]
                    (if (= ::eof value)
                      values
                      (recur (conj values value))))))]
    (spit (str output)
          (with-out-str
            (doseq [form forms]
              (pprint/pprint (adapt-lib-runner-form form)))))
    output))

(defn coordinate-jar [repository coordinate]
  (let [[library version] (str/split coordinate #" ")
        [group artifact] (str/split library #"/")]
    (fs/path repository
             (str/replace group "." "/") artifact version
             (str artifact "-" version ".jar"))))

(defn extract-maven-coordinate! [repository cache coordinate]
  (let [jar (coordinate-jar repository coordinate)
        relative (str (fs/relativize repository jar))
        directory (fs/path cache "lib_tests" "maven-jars"
                           (str/replace relative #"[/\\]" "__"))
        stamp (fs/path directory ".extracted")]
    (when-not (fs/exists? jar)
      (fail! (str "Grenadine did not install " coordinate " at " jar)))
    (when-not (fs/exists? stamp)
      (fs/create-dirs directory)
      (let [result (run-command ["unzip" "-q" "-o" (str jar)
                                 "-d" (str directory)] {})]
        (when-not (zero? (:exit result))
          (fail-command! (str "extracting " jar) result)))
      (spit (str stamp) "ok\n"))
    (str (fs/absolutize directory))))

(defn expanded-coordinates [text]
  (->> (str/split-lines text)
       (filter #(re-matches #"[^ ]+/[^ ]+ [^ ]+" %))
       vec))

(defn prepare-maven-classpath!
  [{:keys [grenadine cache config-value]}]
  (let [suite-dir (fs/path cache "lib_tests")
        repository (fs/path suite-dir "maven-repository")
        config-dir (fs/path suite-dir "maven-deps")
        log-dir (fs/path suite-dir "maven-logs")
        maven-deps (-> (into (sorted-map)
                             (filter (comp :mvn/version val))
                             (:deps config-value))
                       (assoc 'org.clojure/test.check
                              {:mvn/version "1.1.1"}))]
    (doseq [directory [config-dir log-dir]] (fs/create-dirs directory))
    (let [results
          (mapv
           (fn [[library coordinate]]
             (let [base (str/replace (str library) #"[^A-Za-z0-9_.-]" "_")
                   config (fs/path config-dir (str base ".edn"))
                   log (fs/path log-dir (str base ".log"))
                   maven-config
                   (cond-> {:deps {library coordinate}}
                     (:mvn/repos config-value)
                     (assoc :mvn/repos (:mvn/repos config-value)))
                   _ (write-edn! config maven-config)
                   result (run-command [(str grenadine)
                                        "--repository" (str repository)
                                        "--quiet" "--add" (str config)] {})
                   expansion (when (zero? (:exit result))
                               (run-command [(str grenadine)
                                             "--repository" (str repository)
                                             "--expand" (str config)] {}))]
               (spit (str log) (str (:out result) (:err result)))
               {:library library
                :exit (:exit result)
                :coordinates
                (when (and expansion (zero? (:exit expansion)))
                  (expanded-coordinates (:out expansion)))}))
           maven-deps)
          failed (filter #(not (zero? (:exit %))) results)]
      (println (str "Grenadine: installed " (- (count results) (count failed))
                    "/" (count results) " Maven dependency roots"
                    (when (seq failed)
                      (str "; blocked "
                           (str/join ", " (map :library failed))))))
      (reduce
       (fn [paths-by-library {:keys [library coordinates]}]
         (if (seq coordinates)
           (assoc paths-by-library library
                  (mapv #(extract-maven-coordinate!
                          repository cache %)
                        coordinates))
           paths-by-library))
       {}
       results))))

(defn lib-case-result
  [{:keys [root gobb cache work environment command-prefix log-dir]}
   namespace]
  (let [execution (run-command (conj command-prefix namespace)
                               {:dir (str work) :extra-env environment})
        summary (lib-summary (:out execution))
        normalized-execution
        (update-vals execution
                     #(if (string? %)
                        (normalize % [[root "<BABASHKA>"]
                                      [(fs/absolutize cache) "<CACHE>"]
                                      [(fs/absolutize gobb) "<GOBB>"]])
                        %))
        status (cond
                 (and summary
                      (pos? (+ (get summary :fail 0)
                               (get summary :error 0)))) :fail
                 (and summary (zero? (:exit execution))) :pass
                 :else :blocked)
        entry {:namespace namespace
               :status status
               :exit (:exit execution)
               :summary summary
               :diagnostic (when (= :blocked status)
                             (concise-error normalized-execution))}
        base (str/replace namespace #"[^A-Za-z0-9_.-]" "_")]
    (spit (str (fs/path log-dir (str base ".stdout.log"))) (:out execution))
    (spit (str (fs/path log-dir (str base ".stderr.log"))) (:err execution))
    (write-edn! (fs/path log-dir (str base ".edn")) entry)
    entry))

(defn lib-tests! [{:keys [source bb gobb grenadine cache result filters]}]
  (let [root (fs/absolutize source)
        corpus (lib-test-corpus root)
        selected (if (seq filters) (vec filters) (:namespaces corpus))
        unknown (remove (set (:namespaces corpus)) selected)
        work (fs/path cache "lib_tests" "work")
        home (fs/path cache "lib_tests" "home")
        suite-dir (fs/path cache "lib_tests")
        log-dir (fs/path suite-dir "namespaces")
        config (fs/path suite-dir "config.edn")
        upstream-config (read-edn (fs/path root "deps.edn"))
        process-root (fs/path root "process")
        paths (cond-> [(str (fs/path root "test-resources" "lib_tests"))]
                (fs/exists? (fs/path process-root "src"))
                (conj (str (fs/path process-root "src")))
                (fs/exists? (fs/path process-root "test"))
                (conj (str (fs/path process-root "test"))))
        config-value {:paths paths
                      :deps (merge (:deps upstream-config)
                                   (get-in upstream-config
                                           [:aliases :lib-tests :extra-deps]))
                      :mvn/repos (:mvn/repos upstream-config)}
        runner (fs/path root "test-resources" "lib_tests"
                        "babashka" "run_all_libtests.clj")
        path (str (fs/path root "process" "test" "on-path")
                  ":" (System/getenv "PATH"))]
    (when (seq unknown)
      (fail! (str "unknown library test namespaces: "
                  (str/join ", " unknown))))
    (doseq [directory [work home suite-dir log-dir]] (fs/create-dirs directory))
    (write-edn! config config-value)
    (let [maven-paths (prepare-maven-classpath!
                       {:grenadine grenadine :cache cache
                        :config-value config-value})
          platform-paths (get maven-paths 'org.clojure/test.check [])
          classpath-for
          (fn [namespace]
            (let [library (get (:namespace-libraries corpus) namespace)]
              (str/join (System/getProperty "path.separator")
                        (distinct
                         (concat paths platform-paths
                                 (get maven-paths library []))))))
          prepared-runner (prepare-lib-runner! runner suite-dir)
          command-prefix
          (fn [namespace]
            ["timeout" "120" (str gobb)
             "-cp" (classpath-for namespace)
             "-e" (str "(load-file "
                       (pr-str (str prepared-runner)) ")")])
          environment {"HOME" (str home)
                       "GOBB_CACHE" (str (fs/path cache "gobb-cache"))
                       "BABASHKA_TEST_ENV" "native"
                       "GITHUB_REF_NAME" "gobb-upstream-tests"
                       "PATH" path}
          link (fs/path work "bb")]
      (when (fs/exists? link) (fs/delete link))
      (fs/create-sym-link link (fs/absolutize gobb))
      (let [context {:root root :gobb gobb :cache cache :work work
                     :environment environment :command-prefix command-prefix
                     :log-dir log-dir}
            width (apply max (map count selected))
            results
            (mapv (fn [namespace]
                    (print (format (str "lib_test: %-" width "s ") namespace))
                    (flush)
                    (let [entry (lib-case-result
                                 (assoc context
                                        :command-prefix
                                        (command-prefix namespace))
                                 namespace)]
                      (println (str/upper-case (name (:status entry))))
                      entry))
                  selected)
            counts (frequencies (map :status results))
            summaries (keep :summary results)
            summary (reduce #(merge-with + %1 %2)
                            {:test 0 :pass 0 :fail 0 :error 0}
                            summaries)
            case-summary {:total (count results)
                          :pass (get counts :pass 0)
                          :fail (get counts :fail 0)
                          :blocked (get counts :blocked 0)}
            status (cond
                     (= (count results) (:pass case-summary)) :pass
                     (= (count results) (:blocked case-summary)) :blocked
                     :else :fail)
            snapshot {:schema 2
                      :suite :lib-tests
                      :babashka {:version "1.12.218"
                                 :revision "0fb349c414e717800be775ba9cb77c95a9eb700d"}
                      :corpus {:libraries (:libraries corpus)
                               :namespaces (count (:namespaces corpus))}
                      :runner-adaptations
                      [:omit-spec-instrumentation-reset
                       :normalize-keyword-destructuring
                       :grenadine-per-root-dependency-installation
                       :isolated-maven-classpaths]
                      :selection (if (seq filters) (vec filters) :all)
                      :status status
                      :case-summary case-summary
                      :summary summary
                      :results results}]
        (write-edn! result snapshot)
        (println (str "lib_tests: " (name status) " " case-summary
                      " " summary))
        (when-not (= :pass status) (System/exit 1))))))

(defn discover-examples [source]
  (->> (fs/list-dir (fs/path source "examples"))
       (filter fs/regular-file?)
       (filter #(str/ends-with? (str %) ".clj"))
       (map #(str (fs/file-name %)))
       sort vec))

(defn example-command [program source spec]
  (into ["timeout" "30" (str program)
         (str (fs/path source "examples" (:name spec)))]
        (map #(str/replace % "test-resources"
                           (str (fs/path source "test-resources")))
             (:args spec))))

(defn compile-example [gobb gloat source cache name]
  (let [build-root (fs/path cache "examples" "build")
        input (fs/path source "examples" name)
        staged (fs/path build-root "source" name)
        output (fs/path build-root "bin" (str/replace name #"\.clj$" ""))
        source-text (slurp (str input))
        compile-text (if (re-find #"\(defn\s+-main\b" source-text)
                       source-text
                       (str source-text
                            "\n\n(defn -main [& _gobb-example-args])\n"))]
    (fs/create-dirs (fs/parent staged))
    (fs/create-dirs (fs/parent output))
    (spit (str staged) compile-text)
    (let [result (run-command ["timeout" "180" (str gobb) "build"
                               (str staged) "-o" (str output)]
                              {:extra-env {"GOBB_GLOAT" (str gloat)}})
          log-root (fs/path cache "examples" "logs")]
      (fs/create-dirs log-root)
      (spit (str (fs/path log-root (str name ".compile.out"))) (:out result))
      (spit (str (fs/path log-root (str name ".compile.err"))) (:err result))
      result)))

(defn example-result [context name spec]
  (let [{:keys [source bb gobb gloat cache]} context
        compile (compile-example gobb gloat source cache name)
        compile-ok? (zero? (:exit compile))
        base {:name name
              :scenario (:scenario spec)
              :compile (if compile-ok? :pass :fail)}]
    (cond
      (not compile-ok?)
      (assoc base :status :fail :diagnostic (concise-error compile))

      (= :waived (:scenario spec))
      (assoc base :status :waived :reason (:reason spec))

      :else
      (let [example-key (str/replace name #"\.clj$" "")
            bb-work (fs/path cache "examples" "work" example-key "bb")
            gobb-work (fs/path cache "examples" "work" example-key "gobb")
            _ (doseq [directory [bb-work gobb-work]]
                (fs/create-dirs directory))
            replacements [[source "<BABASHKA>"]
                          [(fs/absolutize bb-work) "<WORKDIR>"]
                          [(fs/absolutize gobb-work) "<WORKDIR>"]]
            bb-run (run-command (example-command bb source (assoc spec :name name))
                                {:dir (str bb-work)})
            gobb-run (run-command (example-command gobb source (assoc spec :name name))
                                  {:dir (str gobb-work)})
            log-root (fs/path cache "examples" "logs")
            _ (doseq [[suffix text] [["bb.out" (:out bb-run)]
                                     ["bb.err" (:err bb-run)]
                                     ["gobb.out" (:out gobb-run)]
                                     ["gobb.err" (:err gobb-run)]]]
                (spit (str (fs/path log-root (str name "." suffix)))
                      text))
            comparable (fn [result]
                         {:exit (:exit result)
                          :out (normalize (:out result) replacements)
                          :err (normalize (:err result) replacements)})
            bb-value (comparable bb-run)
            gobb-value (comparable gobb-run)]
        (if (= bb-value gobb-value)
          (assoc base :status :pass)
          (assoc base :status :fail
                 :diagnostic (str "BB " (pr-str bb-value)
                                  "; Gobb " (pr-str gobb-value))))))))

(defn examples! [{:keys [source bb gobb gloat cache manifest result filters]}]
  (let [source (fs/absolutize source)
        manifest-value (read-edn manifest)
        examples (:examples manifest-value)
        discovered (discover-examples source)
        declared (sort (keys examples))
        selected (if (seq filters) (vec filters) discovered)
        unknown (remove (set discovered) selected)
        missing (remove (set declared) discovered)
        extra (remove (set discovered) declared)]
    (when-not (= 1 (:schema manifest-value))
      (fail! "unsupported examples manifest schema"))
    (when (or (seq missing) (seq extra))
      (fail! (str "example manifest drift; missing declarations " (vec missing)
                  ", stale declarations " (vec extra))))
    (when (seq unknown)
      (fail! (str "unknown examples: " (str/join ", " unknown))))
    (let [log-dir (fs/path cache "examples" "logs")
          _ (fs/create-dirs log-dir)
          context {:source source :bb bb :gobb gobb :gloat gloat
                   :cache cache}
          name-width (apply max (map count selected))
          results (mapv (fn [name]
                          (print (format (str "example: %-" name-width "s ")
                                         name))
                          (flush)
                          (let [entry (example-result context name (get examples name))]
                            (write-edn! (fs/path log-dir (str name ".edn")) entry)
                            (println
                             (str/upper-case
                              (clojure.core/name (:status entry))))
                            entry))
                        selected)
          counts (frequencies (map :status results))
          compile-counts (frequencies (map :compile results))
          status (if (zero? (get counts :fail 0)) :pass :fail)
          snapshot {:schema 1
                    :suite :examples
                    :babashka {:version "1.12.218"
                               :revision "0fb349c414e717800be775ba9cb77c95a9eb700d"}
                    :selection (if (seq filters) (vec filters) :all)
                    :status status
                    :summary {:total (count results)
                              :pass (get counts :pass 0)
                              :fail (get counts :fail 0)
                              :waived (get counts :waived 0)
                              :execution-waivers
                              (count (filter #(= :waived (:scenario %)) results))
                              :compile-pass (get compile-counts :pass 0)
                              :compile-fail (get compile-counts :fail 0)}
                    :results results}]
      (write-edn! result snapshot)
      (println (str "examples: " (name status) " " (:summary snapshot)))
      (when-not (= :pass status) (System/exit 1)))))

(let [[mode & args] *command-line-args*]
  (case mode
    "lib-tests"
    (let [[source bb gobb grenadine cache result & filters] args]
      (when-not result
        (fail! "lib-tests requires source bb gobb grenadine cache result"))
      (lib-tests! {:source source :bb bb :gobb gobb :grenadine grenadine
                   :cache cache
                   :result result :filters filters}))

    "examples"
    (let [[source bb gobb gloat cache manifest result & filters] args]
      (when-not result
        (fail! "examples requires source bb gobb gloat cache manifest result"))
      (examples! {:source source :bb bb :gobb gobb :gloat gloat :cache cache
                  :manifest manifest :result result :filters filters}))

    (fail! "expected lib-tests or examples")))
